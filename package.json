{
	"name": "@onlyoffice/docspace-plugin-sdk",
	"version": "2.1.0",
	"minDocSpaceVersion": "3.5.0",
	"description": "Simple plugin system for onlyoffice docspace",
	"license": "Apache-2.0",
	"homepage": "https://www.onlyoffice.com",
	"author": "Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)",
	"maintainers": [
		"Ascensio System SIA <integration@onlyoffice.com> (https://www.onlyoffice.com)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ONLYOFFICE/docspace-plugin-sdk.git"
	},
	"bugs": {
		"url": "https://github.com/ONLYOFFICE/docspace-plugin-sdk",
		"email": "support@onlyoffice.com"
	},
	"keywords": [
		"onlyoffice",
		"docspace",
		"plugin"
	],
	"bin": {
		"build-docspace-plugin": "./npx/buildPlugin.js",
		"create-docspace-plugin": "./npx/index.js"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"prepublish": "tsc",
		"docs": "ts-node tools/update-revision.mjs && typedoc --options typedoc.config.mjs && node tools/generate-index-pages.mjs && ts-node tools/flatten-sidebar.mjs && ts-node tools/update-sidebar.mjs",
		"docs:sync": "npm run docs && node tools/sync-docs.mjs"
	},
	"devDependencies": {
		"@babel/core": "^7.18.10",
		"@types/node": "22.10.1",
		"ts-node": "10.9.2",
		"typedoc": "0.28.14",
		"typedoc-docusaurus-theme": "1.4.2",
		"typedoc-plugin-frontmatter": "1.3.0",
		"typedoc-plugin-markdown": "4.8.1",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"inquirer": "^9.1.0",
		"jszip": "^3.10.1"
	},
	"overrides": {
		"external-editor": {
			"tmp": "^0.2.4"
		},
		"lodash": "^4.17.23"
	},
	"packageManager": "yarn@4.6.0+sha224.acd0786f07ffc6c933940eb65fc1d627131ddf5455bddcc295dc90fd"
}
