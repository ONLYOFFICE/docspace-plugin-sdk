# Indentation and whitespace rules for the whole repository.
# See https://editorconfig.org - most editors apply this natively.
#
# end_of_line is deliberately left out: the checkout is CRLF and git
# handles the conversion itself (core.autocrlf), so pinning it here would
# only make the editor and git disagree.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing spaces are significant in Markdown - two of them force a line break.
[*.md]
trim_trailing_whitespace = false

# Generated by yarn; leave its own formatting alone.
[.yarn/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
