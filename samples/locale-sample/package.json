{
  "name": "locale-sample",
  "pluginName": "LocaleSample",
  "version": "1.0.0",
  "author": "",
  "description": "Sample plugin demonstrating plugin localization for DocSpace — translates UI labels and plugin metadata (name, description) based on the portal language",
  "descriptionLocale": {
    "de": "Beispiel-Plugin zur Demonstration der Plugin-Lokalisierung für DocSpace",
    "az": "DocSpace üçün plagin lokalizasiyasını nümayiş etdirən nümunə plagin"
  },
  "nameLocale": {
    "de": "Locale-Beispiel",
    "az": "Lokal nümunəsi"
  },
  "main": "index.ts",
  "private": true,
  "logo": "docspace-icon.svg",
  "license": "Apache-2.0",
  "homepage": "",
  "scopes": [
    "Settings",
    "ContextMenu"
  ],
  "scripts": {
    "build": "webpack && npx build-docspace-plugin",
    "format": "npx prettier --write ."
  },
  "devDependencies": {
    "ts-loader": "^9.3.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "typescript": "^4.7.4",
    "prettier": "2.8.6",
    "mini-css-extract-plugin": "^2.7.6",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "css-loader": "^6.8.1"
  },
  "dependencies": {
    "@onlyoffice/docspace-plugin-sdk": "file:../../onlyoffice-docspace-plugin-sdk-2.1.0.tgz",
    "i18n-js": "^4.4.3"
  }
}
